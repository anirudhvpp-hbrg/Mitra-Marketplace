{
  "id": "twinmind",
  "name": "TwinMind",
  "tagline": "Meetings into memos",
  "glyph": "mic",
  "category": "Meeting Intelligence",
  "version": "0.10.0",
  "description": "Turn a recording or transcript into a memo: the gist, decisions, action items with owners, and the transcript with speakers, saved to Dropbox.",
  "connectors": [
    {
      "type": "dropbox",
      "path": "Mitra/TwinMind",
      "mode": "readwrite"
    }
  ],
  "needs": [
    "transcription",
    "diarization",
    "meeting-notes"
  ],
  "pipeline": [
    "diarize",
    "transcribe",
    "gist",
    "understand",
    "write"
  ],
  "output": {
    "format": "markdown"
  },
  "uses": ["meetings"],
  "opens": [
    ".wav",
    ".mp3",
    ".m4a",
    ".ogg",
    ".flac",
    ".vtt",
    ".srt"
  ]
}
